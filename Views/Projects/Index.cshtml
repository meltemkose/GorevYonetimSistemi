@model List<GorevYonetimSistemi.Models.Project>

<div class="container mt-4">

    <h2>Proje Listesi</h2>

    <a asp-controller="Projects"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Yeni Proje
    </a>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Proje Adı</th>
                <th>Açıklama</th>
                <th>Oluşturulma Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Name</td>
                <td>@project.Description</td>
                <td>@project.CreatedDate.ToString("dd.MM.yyyy")</td>

                <td>
                    <a asp-controller="Projects"
                       asp-action="Edit"
                       asp-route-id="@project.Id"
                       class="btn btn-warning btn-sm">
                        Düzenle
                    </a>

                    <a asp-controller="Projects"
                       asp-action="Delete"
                       asp-route-id="@project.Id"
                       class="btn btn-danger btn-sm">
                        Sil
                    </a>
                </td>
            </tr>
        }

        </tbody>

    </table>

</div>