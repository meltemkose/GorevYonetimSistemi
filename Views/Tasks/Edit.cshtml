@model GorevYonetimSistemi.Models.TaskItem

<div class="container mt-4">

    <h2>Görevi Düzenle</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label>Başlık</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Açıklama</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label>Durum</label>
            <input asp-for="Status" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Teslim Tarihi</label>
            <input asp-for="Deadline" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Proje</label>
            <select asp-for="ProjectId"
                    asp-items="ViewBag.Projects"
                    class="form-control">
            </select>
        </div>

        <div class="mb-3">
            <label>Kullanıcı</label>
            <select asp-for="UserId"
                    asp-items="ViewBag.Users"
                    class="form-control">
            </select>
        </div>

        <button type="submit" class="btn btn-warning">
            Güncelle
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            İptal
        </a>

    </form>

</div>