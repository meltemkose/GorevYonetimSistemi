@model IEnumerable<GorevYonetimSistemi.Models.TaskItem>

<div class="container mt-4">

    <h2>Görev Listesi</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Yeni Görev
    </a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Başlık</th>
                <th>Durum</th>
                <th>Teslim Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Status</td>
                <td>@item.Deadline.ToShortDateString()</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Düzenle
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Sil
                    </a>
                </td>

            </tr>
        }

        </tbody>

    </table>

</div>