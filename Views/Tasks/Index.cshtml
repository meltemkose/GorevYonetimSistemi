@model IEnumerable<GorevYonetimSistemi.Models.TaskItem>

<div class="container mt-4">

    <h2>Görev Listesi</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Yeni Görev
    </a>
<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6">
             <input type="text"
       name="searchString"
       value="@Context.Request.Query["searchString"]"
       class="form-control"
       placeholder="Görev ara..." />
        </div>

        <div class="col-md-4">
            <select name="status" class="form-control">
    <option value="">Tüm Durumlar</option>

    <option value="Bekliyor"
            selected="@(Context.Request.Query["status"] == "Bekliyor" ? "selected" : null)">
        Bekliyor
    </option>

    <option value="Devam Ediyor"
            selected="@(Context.Request.Query["status"] == "Devam Ediyor" ? "selected" : null)">
        Devam Ediyor
    </option>

    <option value="Tamamlandı"
            selected="@(Context.Request.Query["status"] == "Tamamlandı" ? "selected" : null)">
        Tamamlandı
    </option>
</select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Filtrele
            </button>
        </div>
    </div>
</form>
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Başlık</th>
                <th>Durum</th>
                <th>Teslim Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Status</td>
                <td>@item.Deadline.ToShortDateString()</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Düzenle
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Sil
                    </a>
                </td>

            </tr>
        }

        </tbody>

    </table>

</div>