@model IEnumerable<GorevYonetimSistemi.Models.User>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="container mt-4">
    <h2>Kullanıcı Listesi</h2>

<a asp-controller="Users"
   asp-action="Create"
   class="btn btn-primary mt-2 mb-3">
    Yeni Kullanıcı
</a>

    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Soyad</th>
                <th>E-posta</th>
                <th>Rol</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Surname</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
    <a asp-controller="Users"
       asp-action="Edit"
       asp-route-id="@user.Id"
       class="btn btn-warning btn-sm">
        Düzenle
    </a>
    <a asp-controller="Users"
   asp-action="Delete"
   asp-route-id="@user.Id"
   class="btn btn-danger btn-sm">
    Sil
</a>
</td>
                </tr>
            }
        </tbody>
    </table>
</div>